# Puerto del servidor
PORT=3000
HOST=0.0.0.0

# Secretos (se generan automáticamente en .env si no existen)
JWT_SECRET=
SUPERADMIN_JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Superadministración: define credenciales únicas y robustas en producción
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Demo: desactivado por omisión. Habilítalo sólo sobre un tenant exclusivo.
DEMO_LOGIN_ENABLED=false
DEMO_TENANT_SLUG=
DEMO_USERNAME=demo
# Opcional: si se omite, un usuario demo nuevo recibe una clave interna aleatoria.
DEMO_PASSWORD=

# Validación TLS de PostgreSQL (mantener true en producción)
PG_SSL_REJECT_UNAUTHORIZED=true

# OpenAI (opcional: el chatbot funciona con flujos guiados sin esto)
OPENAI_API_KEY=

# Conexión a Neon (PostgreSQL serverless)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require

# Selección por entorno (opcional):
# NODE_ENV=test        -> usa .env.test
# NODE_ENV=production  -> usa .env.production
# ENV_FILE=.env.custom -> fuerza un archivo específico

# Deploy remoto desde SuperAdmin (opcional)
# Si se omiten, el script deploy/remote-deploy.ps1 usa sus valores por defecto.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=
DEPLOY_REMOTE_APP_DIR=
DEPLOY_SSH_IDENTITY_FILE=
DEPLOY_GIT_REMOTE=origin
DEPLOY_GIT_BRANCH=main
DEPLOY_PM2_APP=chatbotpro
DEPLOY_HEALTH_URL=http://127.0.0.1:3003/

# Notificaciones por email de leads y registros nuevos
# Se envía un correo al NOTIFICATION_EMAIL cuando:
#   - Un lead de demo se registra por primera vez
#   - Un prospecto crea su cuenta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
